{
  "name": "@lihongxu0221/dsh-workspace-ui",
  "description": "Workspace and session UI for DeepSeek Harness: sidebar, Recents, project folders, sections, composer prediction and history, themes, settings workbench, and mobile layout",
  "version": "0.8.3",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "type": "module",
  "author": "李洪旭 <262879651@qq.com>",
  "homepage": "https://github.com/lihongxu0221/dsh-workspace-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihongxu0221/dsh-workspace-ui.git"
  },
  "bugs": {
    "url": "https://github.com/lihongxu0221/dsh-workspace-ui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "workspace-ui",
    "sidebar",
    "sessions",
    "recents",
    "project-folders",
    "sections",
    "composer",
    "input-history",
    "prediction",
    "theme",
    "settings",
    "ui"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@11.28.5",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./session-title": {
      "types": "./lib/types/session-title-plugin.d.ts",
      "default": "./lib/session-title.js"
    },
    "./settings-skin": {
      "types": "./lib/types/settings-skin-plugin.d.ts",
      "default": "./lib/settings-skin.js"
    },
    "./composer": {
      "types": "./lib/types/composer-plugin.d.ts",
      "default": "./lib/composer.js"
    },
    "./sidebar": {
      "types": "./lib/types/sidebar-plugin.d.ts",
      "default": "./lib/sidebar.js"
    },
    "./theme": {
      "types": "./lib/types/theme-plugin.d.ts",
      "default": "./lib/theme.js"
    },
    "./desktop-menu": {
      "types": "./lib/types/desktop-menu-plugin.d.ts",
      "default": "./lib/desktop-menu.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./session-title/icon": "./assets/icon.svg",
    "./settings-skin/icon": "./assets/icon.svg",
    "./composer/icon": "./assets/icon.svg",
    "./sidebar/icon": "./assets/icon.svg",
    "./theme/icon": "./assets/icon.svg",
    "./desktop-menu/icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/composer.js",
    "lib/session-title.js",
    "lib/settings-skin.js",
    "lib/sidebar.js",
    "lib/theme.js",
    "lib/desktop-menu.js",
    "lib/types/**/*.d.ts",
    "assets/icon.svg",
    "locale",
    "cordis.patch.yml",
    "INTEGRATION.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test tests/hover-card.test.mjs tests/session-folders.test.mjs tests/folder-transition.test.mjs tests/node-half.test.mjs tests/sections.test.mjs tests/sidebar.test.mjs tests/workspace-labels.test.mjs",
    "build": "tsc -p tsconfig.json && node scripts/bundle-node.mjs",
    "contract-check": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "lucide-react": "^1.39.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-remote-access": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
